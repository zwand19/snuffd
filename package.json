{
  "name": "snuffd",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "npm run dev --prefix client",
    "install:all": "npm install && cd server && npm install && cd client && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
