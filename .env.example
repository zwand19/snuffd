# Auth0 (Backend)
AUTH0_AUDIENCE=https://snuffd-api
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com/

# Auth0 (Frontend - must be prefixed with VITE_)
VITE_AUTH0_DOMAIN=YOUR_TENANT.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://snuffd-api

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Your GitHub Pages URL (e.g. https://zwand19.github.io/snuffd)
# Set this in Render env vars as ALLOWED_ORIGIN
ALLOWED_ORIGIN=https://YOUR_USERNAME.github.io

# Backend URL (set in GitHub Actions secrets as VITE_API_URL)
# e.g. https://snuffd-server.onrender.com
VITE_API_URL=https://YOUR_RENDER_SERVICE.onrender.com

# Slack webhook for new user notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Server port
PORT=3001
